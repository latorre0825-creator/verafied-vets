# Copy these into your host's environment variable settings.
# NEXT_PUBLIC_* values are baked in at build time: change one, then redeploy.

# REQUIRED: your live site address, no trailing slash
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# REQUIRED: shown in the footer, /privacy and /support
NEXT_PUBLIC_CONTACT_EMAIL=hello@your-domain.com

# Add when the apps are live. Empty = button shows "Coming soon"
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# OPTIONAL: the landing page does not use a database.
# Only set this if you add one later.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
